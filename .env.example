# ==============================================================================
# CharterFlow Environment Configuration Template (Public Values Only)
# ==============================================================================
# NOTE: This file contains non-secret public network defaults for GenLayer Studio Next.
# Do NOT store private keys, mnemonics, or plaintext credentials in this file.
# Credentials are kept securely in the OS Credential Manager via keytar.

# Target GenLayer RPC Endpoint
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api

# Target Chain ID
GENLAYER_CHAIN_ID=61997

# Block Explorer URL
GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com/

# Registered Account Aliases in OS Keychain:
# - cf-pilot-creator
# - cf-pilot-member-a
# - cf-pilot-member-b
# - cf-pilot-recipient
